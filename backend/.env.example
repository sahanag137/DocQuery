# DocQuery Backend Configuration Example

PROJECT_NAME="DocQuery API"
VERSION="1.0.0"
ENVIRONMENT="development"
DEBUG=True

# Security & JWT Secrets (Change in production!)
SECRET_KEY="docquery-super-secret-key-change-in-production-2026!#"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30

# Database Configuration (Defaults to SQLite in data/docquery.db)
# DATABASE_URL="sqlite:///../data/docquery.db"
# Or for PostgreSQL:
# DATABASE_URL="postgresql://user:password@localhost:5432/docquery"

# File Upload Limits
MAX_FILE_SIZE_MB=25
MAX_AVATAR_SIZE_MB=5

# CORS Origins (JSON list or comma-separated)
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:5173","http://127.0.0.1:5173","*"]
